# Provider selection: auto, ollama, openai-compatible, or codex
AI_PROVIDER=ollama

# Free local mode: install Ollama, then run `ollama pull qwen2.5:7b`
OLLAMA_HOST=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b

# Optional OpenAI-compatible provider (Groq free tier, OpenRouter free models,
# LM Studio, vLLM, or another compatible server). Never put this in public JS.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=replace-with-your-server-side-key
# AI_MODEL=llama-3.1-8b-instant

# Optional: keep the current Codex integration for local development.
# AI_PROVIDER=codex
# IELTS_CODEX_PATH=codex.exe
