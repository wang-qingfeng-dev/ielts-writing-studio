# Copy to .env. npm start and the Windows launcher load it with Node's built-in parser.
# Environment variables already set in the shell take precedence.
AI_PROVIDER=ollama
PORT=4318

# Ollama: local inference, no API key. Install Ollama and download this model.
# Speed and structured feedback quality depend on your hardware and model.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional API: choose openai-compatible in the UI or set AI_PROVIDER above.
# AI_BASE_URL=https://your-provider.example/v1
# OPENAI_MODEL=your-provider-model-name
# AI_API_KEY=replace-with-your-server-side-key

# Optional Codex: your own installed, authenticated CLI and account quota.
# AI_PROVIDER=codex
# IELTS_CODEX_PATH=codex.exe

# AI_MODEL remains a legacy fallback when a provider-specific model is unset.
